# Copy this file to .env in this folder and fill it in. .env is gitignored.
# No quotes, no spaces around "=", and no trailing space after a password --
# .env keeps it and the camera answers 401.

# --- credentials ---------------------------------------------------------
# The CAMERA ACCOUNT created in the Tapo app under
#   camera > Settings (gear) > Advanced Settings > Camera Account
# This is NOT your Tapo login. Username and password are 6-32 characters each.
# Shared by every camera below unless overridden.
TAPO_USER=
TAPO_PASS=

# --- cameras -------------------------------------------------------------
# One line per camera. The middle word becomes its name, so TAPO_ROOM_HOST
# defines a camera you refer to as "room". Add as many as you like; nothing
# in the code needs editing.
#
# Find the address in the Tapo app: camera > Settings > Device Info > IP
# Address. Give each one a static IP or a DHCP reservation first, or they will
# move and every script that names one will point at nothing.

TAPO_ROOM_HOST=
TAPO_WRIST_HOST=

# --- optional ------------------------------------------------------------
# Per-camera overrides, if two cameras have different accounts or ports:
# TAPO_ROOM_USER=
# TAPO_ROOM_PASS=
# TAPO_ROOM_PORT=554
#
# A complete RTSP URL, for cameras that are not Tapo. "{stream}" is replaced
# with the stream number if you include it. CAM_ and TAPO_ mean the same thing.
# CAM_DOORWAY_URL=rtsp://user:pw@10.0.0.9:554/h264/ch1/main/av_stream
#
# A single unnamed camera is called "cam":
# TAPO_HOST=192.168.0.50
